{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "cb87fc68df98fc310834ac24dc4c9bddc51bccda",
  "always-update": true,
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring" },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "apps/manager/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/manager/package.json",
          "jsonpath": "$.dependencies['@omw/contracts']"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.dependencies['@omw/contracts']"
        },
        {
          "type": "json",
          "path": "packages/contracts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/launcher/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/launcher/package.json",
          "jsonpath": "$.devDependencies['@omw/contracts']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/manager'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/manager'].dependencies['@omw/contracts']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/web'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['apps/web'].dependencies['@omw/contracts']"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/contracts'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/launcher'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/launcher'].devDependencies['@omw/contracts']"
        }
      ]
    }
  }
}
