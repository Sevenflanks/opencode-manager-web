{
  "namespace": "ai-tools",
  "workerImage": "registry.example.test/omw/worker:coordinator@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "imagePullSecret": "omw-registry",
  "authenticateHost": "auth.example.test",
  "issuer": "https://idp.example.test/realms/example",
  "gatewayConfigSecret": "omw-gateway-config-coordinator-v1",
  "gatewayService": "omw-gateway",
  "ingressClassName": "example-edge",
  "edgePeer": { "namespaceSelector": { "matchLabels": { "kubernetes.io/metadata.name": "example-edge" } }, "podSelector": { "matchLabels": { "app.kubernetes.io/name": "example-edge" } } },
  "dnsPeer": { "namespaceSelector": { "matchLabels": { "kubernetes.io/metadata.name": "kube-system" } }, "podSelector": { "matchLabels": { "k8s-app": "kube-dns" } } },
  "httpsEgress": { "mode": "allow443" },
  "allowedRoles": ["admin"],
  "coordinator": {
    "host": "coordinator.example.test",
    "browserUsername": "omw-coordinator",
    "secretName": "omw-coordinator-browser-v1",
    "registrationSecretName": "omw-coordinator-registration-v1",
    "allowedCidrs": ["10.42.0.0/16"],
    "healthIntervalMs": 15000,
    "healthTimeoutMs": 3000,
    "failureThreshold": 3
  }
}
