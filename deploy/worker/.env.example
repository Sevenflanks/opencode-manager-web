# 使用 setup.mjs 在 repo 外初始化；不要把真正 secret 或 provider auth 放在這裡。
OMW_WORKER_IMAGE=omw-worker:1.18.34
OMW_BROWSER_USERNAME=worker
OMW_EXECUTION_TOKEN_SOURCE=/absolute/external/path/execution-token
OMW_BROWSER_PASSWORD_SOURCE=/absolute/external/path/browser-password
OMW_MANAGER_HOST_PORT=4174
OMW_NATIVE_HOST_PORT=4180
OMW_PUBLIC_ORIGIN=http://127.0.0.1:4174
OMW_NATIVE_ORIGIN=http://127.0.0.1:4180
